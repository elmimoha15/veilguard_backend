# Copy to .env and fill in for real (non-emulator) runs. Never commit .env.

# --- Queue selection ---
# "memory"  → InMemoryQueue (local dev / tests, dependency-free)
# "cloudtasks" → Google Cloud Tasks (production)
QUEUE_IMPL=memory

# --- GCP / Firebase ---
# Emulator work: use a "demo-" prefixed id (no credentials needed).
# REAL project (what `npm run dev:real` targets): veilguard-d6710
GCLOUD_PROJECT=veilguard-d6710
# Set automatically by `firebase emulators:exec`. Only set by hand to force the
# Admin SDK at a running emulator: FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Admin SDK credentials (REAL Firebase only) ---
# The backend verifies ID tokens and reads/writes Firestore with the Admin SDK,
# which needs a service-account credential when NOT on the emulator.
# Firebase console → Project settings → Service accounts → "Generate new private
# key" → save the JSON under ./secrets/ (gitignored) and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/veilguard-admin.json

# --- Worker (Cloud Run) ---
PORT=8081
# Wall-clock cap for a single scan before it is marked "error".
SCAN_TIMEOUT_MS=120000

# --- Cloud Tasks (only when QUEUE_IMPL=cloudtasks) ---
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=veilguard-scans
# The deployed worker's public URL that Cloud Tasks will POST /runScan to.
WORKER_URL=https://veilguard-worker-xxxxx-uc.a.run.app
# Service account email Cloud Tasks uses to mint an OIDC token for the worker.
WORKER_INVOKER_SA=veilguard-tasks@demo-veilguard.iam.gserviceaccount.com

# --- Rate limiting (createScan) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# --- Connected deep scans (Slice 5): credential encryption ---
# AES-256-GCM key for encrypting stored OAuth tokens in secrets/{uid}.
# Generate a real one:  openssl rand -hex 32   (never commit the value)
ENCRYPTION_KEY=

# Public base URL the OAuth providers redirect back to (e.g. an ngrok URL in dev,
# your API domain in prod). Callbacks land at <base>/connect/<provider>/callback.
# Register <OAUTH_CALLBACK_BASE>/connect/supabase/callback as an authorized
# redirect URL in your Supabase OAuth app.
OAUTH_CALLBACK_BASE=

# Connection mock seam (OAuth is REAL by default outside the emulator):
#   unset → mock under the Firestore emulator (credential-free tests)
#   0     → force REAL OAuth even while Firestore is emulated (npm run dev:all sets this)
#   1     → force mock
# MOCK_CONNECTIONS=0
# Where the callback bounces the browser after connecting.
FRONTEND_URL=http://localhost:3000

# --- GitHub App (real GitHub connections) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
# CONFIDENTIAL — server-side only, never sent to the client, never committed.
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem

# --- Supabase Management API OAuth (real Supabase connections) ---
# client_id is a public identifier (appears in the authorize URL by design).
SUPABASE_OAUTH_CLIENT_ID=
# CONFIDENTIAL — server-side only, never sent to the client, never committed.
SUPABASE_OAUTH_CLIENT_SECRET=
# Optional: override the local broken-RLS fixture used by MOCK OAuth mode.
# MOCK_SUPABASE_POLICIES_PATH=test-fixtures/supabase-broken-rls

# --- Monitoring (Slice 7): scheduled + push-triggered re-scans ---
# REQUIRED in prod or monitoring is inert (both endpoints 401 when unset).
# Shared secret Cloud Scheduler sends as header `x-veilguard-cron` to POST
# /runSchedules. Generate: openssl rand -hex 32
SCHEDULE_SECRET=
# GitHub App webhook secret, used to verify X-Hub-Signature-256 on POST
# /githubWebhook. Must EXACTLY match the "Webhook secret" set in the GitHub App
# settings. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Tuning (optional): max monitored apps enqueued per scheduler tick; push debounce.
# MONITOR_MAX_PER_RUN=50
# MONITOR_PUSH_DEBOUNCE_MS=180000

# --- Email (Resend) ---
# When set, emails are sent via Resend (https://resend.com). Unset → the console
# transport logs + captures instead (tests/dev), so email is optional to run.
RESEND_API_KEY=
# From addresses — all on the VERIFIED sending subdomain (send.veilguard.dev).
ALERT_FROM_EMAIL=Veilguard <alerts@send.veilguard.dev>
EMAIL_FROM=Veilguard <hello@send.veilguard.dev>
EMAIL_MARKETING_FROM=Veilguard <news@send.veilguard.dev>
EMAIL_REPLY_TO=support@veilguard.dev
# Base URL used in email links + Firebase Admin action-code URLs (verify/reset).
APP_BASE_URL=https://veilguard.dev
