rules_version = '2';

// Slice 4 — ownership-enforced read model.
//
// A scan is either anonymous (ownerUid == null: the free public path, readable
// by whoever knows its unguessable id) or owned (ownerUid == a user's uid).
// Users see ONLY their own owned scans + their own profile. All writes to scans
// and users' protected fields go through the Admin SDK (server), which bypasses
// these rules; clients can never escalate their plan or write scan docs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A scan doc is readable if it's anonymous, or owned by the caller.
    function scanReadable(scanId) {
      let s = get(/databases/$(database)/documents/scans/$(scanId)).data;
      return s.ownerUid == null || (signedIn() && request.auth.uid == s.ownerUid);
    }

    // ---- secrets/{uid} : encrypted credentials — DENIED to all clients ----
    // Only the Admin SDK (server) ever reads/writes these. A user's GitHub token
    // / Supabase connection string is never client-readable, encrypted or not.
    match /secrets/{uid} {
      allow read, write: if false;
    }

    // ---- users/{uid} : a user may only touch their OWN doc ----
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;                       // never enumerable
      // May self-create, but only with plan 'free' (no self-upgrade).
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.plan == 'free'
                    && request.resource.data.uid == uid;
      // May edit profile fields, but NOT plan or uid (billing changes plan
      // server-side in Slice 6).
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.plan == resource.data.plan
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // ---- scans/{scanId} ----
    match /scans/{scanId} {
      // Read a single scan by id: anonymous scans are public-by-id; owned scans
      // only by their owner.
      allow get: if resource.data.ownerUid == null
                 || (signedIn() && request.auth.uid == resource.data.ownerUid);
      // Listing is ONLY ever your own scans: every candidate doc must be owned
      // by you. This makes a `where('ownerUid','==', myUid)` query pass and any
      // broader/other-user/anonymous list fail.
      allow list: if signedIn() && request.auth.uid == resource.data.ownerUid;
      // Clients never write scan docs (createScan/claimScan go through the API).
      allow write: if false;

      // Findings inherit the parent scan's readability.
      match /findings/{findingId} {
        allow get, list: if scanReadable(scanId);
        allow write: if false;

        // Paid content stays locked to ALL clients until billing (Slice 6).
        match /private/{doc} {
          allow read, write: if false;
        }
      }
    }

    // Everything else denied by default.
  }
}
