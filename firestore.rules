rules_version = '2';

// Slice 3 — public free-scan read model.
//
// A free scan has no owner yet (auth arrives in Slice 4), so a scan is readable
// by anyone who knows its (unguessable, 20-char) scanId — but the collection is
// NOT enumerable, and the paid fix content is NOT client-readable. All writes go
// through the Admin SDK (worker + API), which bypasses these rules, so clients
// can never write.
service cloud.firestore {
  match /databases/{database}/documents {

    match /scans/{scanId} {
      // Read a known scan by id, but do NOT allow listing/enumerating scans.
      allow get: if true;
      allow list: if false;
      // No client writes, ever.
      allow write: if false;

      match /findings/{findingId} {
        // Stream/read the findings of a KNOWN scan (get + list within this
        // scan). You still must know the parent scanId to reach this path.
        allow get, list: if true;
        allow write: if false;

        // Paid content (fix / fixPrompt) is locked at the data layer: clients
        // cannot read it at all. Only the Admin SDK (server) can.
        match /private/{doc} {
          allow read, write: if false;
        }
      }
    }

    // Everything else is denied by default (no explicit allow).
  }
}
