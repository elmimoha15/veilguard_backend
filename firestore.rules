rules_version = '2';

// Slice 4 — ownership-enforced read model.
//
// A scan is either anonymous (ownerUid == null: the free public path, readable
// by whoever knows its unguessable id) or owned (ownerUid == a user's uid).
// Users see ONLY their own owned scans + their own profile. All writes to scans
// and users' protected fields go through the Admin SDK (server), which bypasses
// these rules; clients can never escalate their plan or write scan docs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A scan doc is readable if it's anonymous, or owned by the caller.
    function scanReadable(scanId) {
      let s = get(/databases/$(database)/documents/scans/$(scanId)).data;
      return s.ownerUid == null || (signedIn() && request.auth.uid == s.ownerUid);
    }

    // ---- secrets/{uid} : encrypted credentials — DENIED to all clients ----
    // Only the Admin SDK (server) ever reads/writes these. A user's GitHub token
    // / Supabase connection string is never client-readable, encrypted or not.
    match /secrets/{uid} {
      allow read, write: if false;
    }

    // ---- users/{uid} : a user may only touch their OWN doc ----
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;                       // never enumerable
      // May self-create, but only with plan 'free' (no self-upgrade).
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.plan == 'free'
                    && request.resource.data.uid == uid;
      // May edit profile fields, but NOT plan/uid or any billing field — those
      // are written server-side ONLY (Polar webhook via the Admin SDK). `.get(f,
      // null)` compares whether the field is present or absent, so a client can
      // neither change nor introduce these fields. Apps are unlimited; the only
      // quota is the server-enforced monthly scan cap (see createScan/…).
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.plan == resource.data.plan
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.get('status', null) == resource.data.get('status', null)
                    && request.resource.data.get('subscriptionId', null) == resource.data.get('subscriptionId', null)
                    && request.resource.data.get('polarCustomerId', null) == resource.data.get('polarCustomerId', null)
                    && request.resource.data.get('currentPeriodEnd', null) == resource.data.get('currentPeriodEnd', null)
                    && request.resource.data.get('cancelAtPeriodEnd', null) == resource.data.get('cancelAtPeriodEnd', null);
      allow delete: if false;
    }

    // ---- usage/{uid} : server-authoritative per-user usage counters ----
    // Written ONLY by the Admin SDK (scan/AI-fix accounting). A user may read its
    // own quota (the /me endpoint also surfaces it); clients can never write it.
    match /usage/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---- webhookDeliveries/{id} + fixCache/{key} : server-only ----
    // GitHub webhook delivery-id dedup, and the cross-user cache of Claude-
    // generated fixes. Both Admin-SDK only; never client-accessible.
    match /webhookDeliveries/{id} { allow read, write: if false; }
    match /fixCache/{key} { allow read, write: if false; }

    // ---- billingEvents/{eventId} : processed Polar webhook ids (idempotency) ----
    // Server-only (Admin SDK). Never client-accessible.
    match /billingEvents/{eventId} {
      allow read, write: if false;
    }

    // ---- scans/{scanId} ----
    match /scans/{scanId} {
      // Read a single scan by id: anonymous scans are public-by-id; owned scans
      // only by their owner.
      allow get: if resource.data.ownerUid == null
                 || (signedIn() && request.auth.uid == resource.data.ownerUid);
      // Listing is ONLY ever your own scans: every candidate doc must be owned
      // by you. This makes a `where('ownerUid','==', myUid)` query pass and any
      // broader/other-user/anonymous list fail.
      allow list: if signedIn() && request.auth.uid == resource.data.ownerUid;
      // Clients never write scan docs (createScan/claimScan go through the API).
      allow write: if false;

      // Findings inherit the parent scan's readability.
      match /findings/{findingId} {
        allow get, list: if scanReadable(scanId);
        allow write: if false;

        // Paid content stays locked to ALL clients until billing (Slice 6).
        match /private/{doc} {
          allow read, write: if false;
        }
      }
    }

    // ---- Slice 7: monitoring — owner-read, server-only write ----
    // Monitoring events (the diff/alert feed the dashboard renders) and per-app
    // run state. Written ONLY by the server (worker/scheduler via Admin SDK,
    // which bypasses rules); a client may read only its OWN docs, never write.
    match /monitorEvents/{eventId} {
      allow get: if signedIn() && request.auth.uid == resource.data.uid;
      allow list: if signedIn() && request.auth.uid == resource.data.uid;
      allow write: if false;
    }
    match /monitorRuns/{runId} {
      allow get: if signedIn() && request.auth.uid == resource.data.uid;
      allow list: if signedIn() && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // ---- feedback/{id} : user feedback/help submissions — server-only ----
    // Every submission is written by the Admin SDK (POST /feedback), which
    // bypasses these rules. Clients can NEVER create, read, list, update, or
    // delete — feedback is private to the owner (read it in the Firebase console
    // or via the Admin SDK). This prevents both enumeration of others' messages
    // and direct client spam into the collection.
    match /feedback/{id} {
      allow read, write: if false;
    }

    // Everything else denied by default.
  }
}
